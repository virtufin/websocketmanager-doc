<div class="git-info">
  {{#gitCommitHash}}
  <a href="{{gitCommitUrl}}" target="_blank" rel="noopener" class="commit-badge" title="View commit {{gitCommitHash}}">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 82 22" width="82" height="22" style="vertical-align:middle;">
      <rect width="82" height="22" rx="4" fill="#e9ecef" stroke="currentColor" stroke-width="0.75" opacity="0.6"/>
      <text x="41" y="15.5" text-anchor="middle" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="11" font-weight="600" fill="currentColor">{{gitCommitHash}}</text>
    </svg>
  </a>
  {{/gitCommitHash}}
</div>